+    // ------------------------------------------------------- measurement hooks
+
+    fun onMeasureIntent() {
+        if (!MeasureConfig.enabled) return
+        viewModelScope.launch {
+            _state.first { it.sessionsLoaded }
+            when {
+                MeasureConfig.seedLongChat -> {
+                    seedMeasureLongChat()
+                    if (MeasureConfig.fakeRate > 0) {
+                        updateMessages { it + ChatMessage(role = "user", text = MeasureConfig.prompt) }
+                        delay(1200)
+                        runFakeStream(MeasureConfig.fakeRate)
+                    }
+                }
+                MeasureConfig.thinkingChat -> seedMeasureThinkingChat()
+                MeasureConfig.emptyChat -> prepareMeasureChat("measure-empty", "Measure idle")
+                MeasureConfig.realRun -> startMeasureReal()
+                MeasureConfig.fakeRate > 0 -> {
+                    prepareMeasureChat("measure-fake", "Measure fake")
+                    delay(400)
+                    runFakeStream(MeasureConfig.fakeRate)
+                }
+            }
+        }
+    }
+
+    private fun installMeasureSession(id: String, title: String, messages: List<ChatMessage>) {
+        val now = System.currentTimeMillis()
+        val summary = SessionSummary(
+            id = id,
+            title = title,
+            createdAt = now,
+            updatedAt = now,
+            messageCount = messages.count { it.role == "user" || it.role == "assistant" },
+            preview = previewOf(messages),
+            modelName = _state.value.modelName.orEmpty(),
+        )
+        sessionMessages[id] = messages
+        _state.update {
+            it.copy(
+                sessions = listOf(summary) + it.sessions.filter { s -> s.id != id },
+                activeSessionId = id,
+                activeSessionTitle = title,
+                messages = messages,
+                input = "",
+                generating = false,
+                progress = null,
+                error = null,
+                pendingAttachments = emptyList(),
+                scrollRequest = it.scrollRequest + 1,
+            )
+        }
+        scheduleSave()
+    }
+
+    private fun prepareMeasureChat(id: String, title: String) {
+        installMeasureSession(id, title, emptyList())
+    }
+
+    private fun seedMeasureLongChat() {
+        val base = System.nanoTime()
+        val messages = ArrayList<ChatMessage>(60)
+        for (i in 1..30) {
+            messages += ChatMessage(
+                id = base + i * 2,
+                role = "user",
+                text = "Вопрос $i: объясни шаг $i и приведи короткий пример.",
+            )
+            val thinking = if (i % 3 == 0) {
+                "<" + "think" + ">\nНужно проверить формулировку, выбрать пример и оценить сложность.\n" +
+                    "Шаг 1: разобрать условие.\nШаг 2: собрать пример.\nШаг 3: записать вывод.\n" +
+                    "</" + "think" + ">\n\n"
+            } else {
+                ""
+            }
+            val code = if (i % 4 == 0) {
+                "\n\n```kotlin\nfun demo$i(value: Int): Int {\n    val scaled = value * $i\n    return scaled + 1\n}\n```"
+            } else {
+                ""
+            }
+            val answer = thinking +
+                "## Ответ $i\n\n" +
+                "Это тестовый ответ с **Markdown**, *курсивом* и `inline code`. " +
+                "Он достаточно длинный, чтобы строка переносилась и список занимал несколько строк.\n\n" +
+                "1. Первый пункт ответа $i.\n2. Второй пункт с пояснением.\n3. Третий пункт для высоты сообщения." +
+                code
+            messages += ChatMessage(
+                id = base + i * 2 + 1,
+                role = "assistant",
+                text = answer,
+                metrics = MessageMetrics(
+                    promptTokens = 120 + i,
+                    promptTokensPerSecond = 20f,
+                    generatedTokens = 80 + i,
+                    generationTokensPerSecond = 12f,
+                    durationMs = 7_000L + i,
+                ),
+            )
+        }
+        installMeasureSession("measure-long", "Perf long chat", messages)
+    }
+
+    private fun seedMeasureThinkingChat() {
+        val thinking = buildString {
+            append("<" + "think" + ">")
+            append("\n")
+            for (i in 1..45) {
+                append("Шаг $i: проверяем гипотезу, сравниваем варианты и уточняем вывод. ")
+                if (i % 5 == 0) append("\n\n")
+            }
+            append("\n")
+            append("</" + "think" + ">")
+            append("\n\n")
+            append("## Итог\n\n")
+            append("Длинный блок размышлений нужен, чтобы измерить раскрытие и сворачивание. ")
+            append("**Ответ** остаётся видимым, а thinking можно открыть и закрыть десять раз.")
+        }
+        val now = System.nanoTime()
+        installMeasureSession(
+            "measure-thinking",
+            "Perf thinking",
+            listOf(
+                ChatMessage(id = now, role = "user", text = "Покажи длинное рассуждение."),
+                ChatMessage(
+                    id = now + 1,
+                    role = "assistant",
+                    text = thinking,
+                    metrics = MessageMetrics(
+                        promptTokens = 40,
+                        promptTokensPerSecond = 20f,
+                        generatedTokens = 220,
+                        generationTokensPerSecond = 10f,
+                        durationMs = 22_000L,
+                    ),
+                ),
+            ),
+        )
+    }
+
+    private suspend fun startMeasureReal() {
+        val file = File(modelsDir, "LFM3-1.7B-GSQ-1GB-IQ4_XS_RCO.gguf")
+        if (!file.isFile) {
+            Log.e(TAG, "measure: fixed model is missing")
+            return
+        }
+        if (!_state.value.modelLoaded || _state.value.modelName != file.name) {
+            loadModel(file)
+            val ready = withTimeoutOrNull(180_000) {
+                _state.first { it.modelLoaded && it.modelName == file.name }
+            }
+            if (ready == null) {
+                Log.e(TAG, "measure: fixed model load timed out")
+                return
+            }
+        }
+        updateSettings {
+            it.copy(
+                temperature = 0f,
+                maxTokens = 256,
+                topP = 0.95f,
+                topK = 40,
+                thinkingBudget = 0,
+                toolsEnabled = false,
+            )
+        }
+        prepareMeasureChat("measure-real", "Measure real")
+        _state.update { it.copy(input = MeasureConfig.prompt) }
+        delay(500)
+        Log.i("Measure", "real_send")
+        send()
+    }
+
+    private suspend fun runFakeStream(rate: Int) {
+        val seconds = 30
+        val total = if (MeasureConfig.fakeTokens > 0) MeasureConfig.fakeTokens else rate * seconds
+        val chunks = fakeChunks(total)
+        if (chunks.isEmpty()) return
+
+        val assistant = ChatMessage(role = "assistant", text = "", streaming = true)
+        updateMessages { it + assistant }
+        _state.update {
+            it.copy(
+                input = "",
+                generating = true,
+                error = null,
+                progress = null,
+                scrollRequest = it.scrollRequest + 1,
+            )
+        }
+
+        val full = StringBuilder()
+        val pending = StringBuilder()
+        var tokens = 0
+        var lastPublish = 0L
+        val startedAt = System.nanoTime()
+        Log.i("Measure", "fake_start rate=$rate total=$total publish_hz=${MeasureConfig.publishHz}")
+
+        for ((index, chunk) in chunks.withIndex()) {
+            if (cancelRequested) break
+            delay(1000L / rate)
+            full.append(chunk)
+            pending.append(chunk)
+            tokens++
+            val now = SystemClock.elapsedRealtime()
+            val interval = if (MeasureConfig.publishHz > 0) 1000L / MeasureConfig.publishHz else 0L
+            val due = interval == 0L || now - lastPublish >= interval || index == chunks.lastIndex
+            if (due) {
+                appendToMessage(assistant.id, pending.toString())
+                pending.clear()
+                lastPublish = now
+                updateMessageMetrics(assistant.id) {
+                    it.copy(
+                        promptTokens = 120,
+                        promptTokensPerSecond = 20f,
+                        generatedTokens = tokens,
+                        generationTokensPerSecond = rate.toFloat(),
+                        durationMs = (System.nanoTime() - startedAt) / 1_000_000L,
+                    )
+                }
+            }
+        }
+        if (pending.isNotEmpty()) {
+            appendToMessage(assistant.id, pending.toString())
+        }
+        finishAssistant(
+            assistant.id,
+            full.toString(),
+            tokens,
+            null,
+            false,
+            20f,
+            120,
+            rate.toFloat(),
+            startedAt,
+        )
+        _state.update { it.copy(generating = false, progress = null) }
+        Log.i("Measure", "fake_end tokens=$tokens")
+    }
+
+    private fun fakeChunks(total: Int): List<String> {
+        val text = StringBuilder()
+        text.append("<" + "think" + ">")
+        text.append("\n")
+        for (i in 1..12) {
+            text.append("Шаг $i: проверяем план ответа, структуру примера и вывод.\n")
+        }
+        text.append("\n")
+        text.append("</" + "think" + ">")
+        text.append("\n\n")
+        var section = 0
+        while (tokenEstimate(text) < total) {
+            section++
+            text.append("## Раздел $section\n\n")
+            text.append("Это демонстрационный ответ для замера UI. **Жирный текст**, *курсив* и `inline code` проверяют разметку.\n\n")
+            text.append("```kotlin\nfun step$section(value: Int): Int {\n    val scaled = value * $section\n    return scaled + 1\n}\n```\n\n")
+            text.append("1. Первый пункт раздела $section.\n2. Второй пункт с [ссылкой](https://example.com).\n3. Третий пункт, чтобы текст занимал несколько строк и переносился.\n\n")
+        }
+        val words = Regex("\\S+\\s*").findAll(text.toString()).map { it.value }.toList()
+        if (words.size <= total) return words
+        return words.subList(0, total)
+    }
+
+    private fun tokenEstimate(text: CharSequence): Int = text.count { it == ' ' } + 1
